{
	// ── Python / Django ──────────────────────────────────────────────
	// Esta carpeta es la raíz del backend: `core` y `apps` se resuelven desde aquí
	"python.analysis.extraPaths": ["${workspaceFolder}"],
	"python.analysis.typeCheckingMode": "basic",
	"python.analysis.autoImportCompletions": true,
	"python.analysis.exclude": ["**/static", "**/.dbdata", "**/migrations"],

	// Black + isort + flake8 (misma línea máxima y perfil compatible)
	"black-formatter.args": ["--line-length", "88"],
	"isort.args": ["--profile", "black"],
	"flake8.args": [
		"--max-line-length=88",
		"--extend-ignore=E203,W503",
		"--exclude=migrations,static,.dbdata,__pycache__"
	],
	"[python]": {
		"editor.defaultFormatter": "ms-python.black-formatter",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.organizeImports": "explicit"
		},
		"editor.rulers": [88]
	},

	// ── Archivos del backend ─────────────────────────────────────────
	"files.associations": {
		"**/templates/**/*.html": "django-html",
		"**/templates/**/*.txt": "django-txt",
		"dockerfile": "dockerfile",
		"docker-compose*.yml": "dockercompose",
		"docker-compose*.yaml": "dockercompose",
		".env*": "dotenv"
	},
	"emmet.includeLanguages": {
		"django-html": "html"
	},
	"[yaml][dockercompose]": {
		"editor.tabSize": 2
	},

	// ── Editor general ───────────────────────────────────────────────
	"editor.bracketPairColorization.enabled": true,
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	"files.eol": "\n",

	// ── Ruido fuera del explorador y de la búsqueda ──────────────────
	"files.exclude": {
		"**/__pycache__": true,
		"**/*.pyc": true
	},
	"search.exclude": {
		"**/static": true,
		"**/.dbdata": true,
		"**/db.sqlite3": true
	},
	"files.watcherExclude": {
		"**/.dbdata/**": true,
		"**/__pycache__/**": true
	},

	// ── Docker ───────────────────────────────────────────────────────
	"docker.compose.detached": true
}
